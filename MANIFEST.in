include LICENSE
include README.rst
recursive-include src/pyqreg *.pyx *.pxd
recursive-include tests *.py

# The .c files are generated by Cython at build time and are not tracked in
# git, so shipping whatever happens to be in the working tree would make the
# sdist contents depend on local build state.
global-exclude *.c *.so *.pyd
prune build
